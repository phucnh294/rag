POSTGRES_HOST=host.docker.internal
POSTGRES_HOST_PORT=6024
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ai_db
EMBEDDING_DIM=768

CHAT_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
#gemini-2.5-flash-lite, gemini-3.6-flash: deprecated for new users as of 2026-08-29

OLLAMA_NOMIC_EMBED_TEXT_HOST=host.docker.internal
OLLAMA_NOMIC_EMBED_TEXT_HOST_PORT=11437
OLLAMA_NOMIC_EMBED_TEXT_MODEL=nomic-embed-text

OLLAMA_LLAMA31_HOST=host.docker.internal
OLLAMA_LLAMA31_HOST_PORT=11436
OLLAMA_LLAMA31_MODEL=llama3.1:8b

# Set to false to skip the rerank-service entirely and use raw vector
# similarity ordering instead — useful for A/B comparing answer quality.
RERANK_ENABLED=true
RERANK_HOST=host.docker.internal
RERANK_HOST_PORT=8088
