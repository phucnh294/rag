# Secrets / local environment config — never commit real values.
# See *.env.*.example / *.env.example templates alongside each real file.
.env
.env.*
!*.env.example
!.env.*.example

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Runtime logs (rotated app logs, not source)
logs/
*.log

# Runtime prompt/response audit log (auto-generated per /chat request) -
# the manually-written session transcripts in the same folder are NOT
# matched by this pattern and stay tracked.
prompt_log_*.md

# Docker
*.pid

# OS/editor cruft
.DS_Store
Thumbs.db
